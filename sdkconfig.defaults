#
# ─────────────────────── PROJECT OVERRIDES (not from the seed) ───────────────
#
# Flash size. The seed is built for a generic 4MB Arduino target, but every
# env on the hybrid path here is a 16MB board (board_upload.flash_size = 16MB,
# board_build.partitions = openevse_16mb.csv). Without this the build prints
# "Flash memory size mismatch detected. Expected 16MB, found 4MB!" every run
# and writes a 4MB size into the image header — harmless for OTA (the device
# keeps its existing bootloader) but wrong for a factory flash.
# If a 4MB board is ever put on the hybrid path it needs its own overlay file
# rather than a change here.
#
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
#
# The partition table is deliberately NOT set here: PlatformIO generates
# partitions.bin from board_build.partitions outside the sdkconfig, so the
# CONFIG_PARTITION_TABLE_* values in the seed are inert. Leaving them alone
# keeps the per-env CSV choice in platformio.ini where it belongs.
#

# Bluetooth: compiled in by the Arduino seed but never used by this firmware
# (nothing in src/ references BT/BLE, and esp_bt_controller_mem_release is
# never called, so the controller's DRAM was simply wasted). With IDF built
# from source we can drop the whole stack. Last-value-wins overrides the
# seed's CONFIG_BT_ENABLED=y above.
CONFIG_BT_ENABLED=n

# PSRAM: neither the TFT (denky32/WROOM) nor the 16MB WROOM board has PSRAM;
# drop the probe and support structures. (Seed had CONFIG_SPIRAM=y.)
CONFIG_SPIRAM=n

# WiFi buffers: static RX 8->6 (~1.6K DRAM each) and dynamic RX/TX caps 32->16.
# Costs burst throughput only; this workload is small JSON/MQTT frames.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16

# Allow esp_flash writes to the bootloader/partition-table regions: enables the
# in-place 4MB->16MB repartition OTA path (see upstream PR #1136 discussion —
# the ESPHome-proven mechanism). Guarded at runtime by whoever calls it; no
# behavior change for normal operation.
CONFIG_SPI_FLASH_DANGEROUS_WRITE_ALLOWED=y
