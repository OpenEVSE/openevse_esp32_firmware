{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./*.pem)",
      "Read(./*/*.pem)",
      "Read(./*/*/*.pem)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./*/.env)",
      "Read(./*/.env.local)",
      "Read(./*/*/.env)",
      "Read(./*/*/.env.local)",
      "Read(./.vscode/settings.json)",
      "Read(./.vscode/settings.local.json)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(curl *update*)"
    ]
  }
}
