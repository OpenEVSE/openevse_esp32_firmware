#!/usr/bin/env bash
#
# PlatformIO wrapper for the two-core tree.
#
# This repo builds on two incompatible Arduino-ESP32 cores:
#   * core-2.x  (platform espressif32@6.12.0)   -> the 4MB boards (default)
#   * core-3.x  (platform ${common.platform_core3}, pioarduino) -> 16MB / P4
#
# Both platforms declare ~13 package names in common (framework-arduinoespressif32,
# framework-espidf, the toolchains, several tool-*) but pin different versions, so
# building a core-2 env right after a core-3 env (or vice versa) in the SAME
# PLATFORMIO_CORE_DIR evicts and re-downloads those packages every switch.
#
# Fix: give each core its own PLATFORMIO_CORE_DIR. core-2 keeps the default
# (~/.platformio) so bare `pio`, CI and IDE integrations are unchanged; core-3
# builds are redirected to a separate dir. Switching cores then never re-downloads.
#
# Usage: exactly like pio, e.g.
#   scripts/pio run -e openevse_p4 -t upload
#   scripts/pio run -e openevse_wifi_v1
#   scripts/pio device monitor
#
# Override the core-3 dir with PIO_CORE3_DIR; force a specific pio binary with
# PLATFORMIO_BIN.
set -euo pipefail

# Envs that build on the core-3 (pioarduino) platform. Keep in sync with the
# `platform = ${common.platform_core3}` envs in platformio.ini (including envs
# that `extends` one of them).
CORE3_ENVS="openevse_wifi_v1_16mb openevse_wifi_tft_v1 openevse_wifi_tft_v1_dev"
CORE3_DIR="${PIO_CORE3_DIR:-$HOME/.platformio-core3}"

# Pull the -e / --environment value(s) out of the args.
envs=""
prev=""
for a in "$@"; do
  case "$prev" in
    -e|--environment) envs="$envs $a" ;;
  esac
  case "$a" in
    -e=*|--environment=*) envs="$envs ${a#*=}" ;;
  esac
  prev="$a"
done

want_core3=0
want_core2=0
core3_env=""
for e in $envs; do
  case " $CORE3_ENVS " in
    *" $e "*) want_core3=1; [ -n "$core3_env" ] || core3_env="$e" ;;
    *)        want_core2=1 ;;
  esac
done

if [ "$want_core3" = 1 ] && [ "$want_core2" = 1 ]; then
  echo "scripts/pio: won't build core-2 and core-3 envs in one invocation" >&2
  echo "             (they live in separate PLATFORMIO_CORE_DIRs) -- split them." >&2
  exit 2
fi

# Resolve the real pio binary (never recurse into this wrapper).
PIO_BIN="${PLATFORMIO_BIN:-}"
if [ -z "$PIO_BIN" ]; then
  if [ -x "$HOME/.platformio/penv/bin/pio" ]; then
    PIO_BIN="$HOME/.platformio/penv/bin/pio"
  elif command -v platformio >/dev/null 2>&1; then
    PIO_BIN="$(command -v platformio)"
  else
    echo "scripts/pio: cannot find the pio/platformio executable (set PLATFORMIO_BIN)" >&2
    exit 127
  fi
fi

if [ "$want_core3" = 1 ]; then
  export PLATFORMIO_CORE_DIR="$CORE3_DIR"
  echo "scripts/pio: core-3 -> PLATFORMIO_CORE_DIR=$PLATFORMIO_CORE_DIR" >&2

  # Work around a pioarduino/platform-espressif32 bug (seen on 55.03.311, and only
  # with PlatformIO Core >= 6.2.0 -- older Core releases pin the same tool-scons
  # version the platform expects, so the mismatch below never triggers):
  # platform.json pins tool-scons to its own "package-version" (e.g. 4.40801.0),
  # but PlatformIO Core independently hardcodes a DIFFERENT tool-scons requirement
  # (~4.41101.0, the official package) to run its own build engine -- and both
  # land in the same packages/tool-scons slot. When the platform notices the
  # installed version doesn't match its pin, its own version-mismatch handler
  # (_handle_existing_tool in platform.py) deletes packages/tool-scons to force a
  # reinstall, but the reinstall check requires a .piopm file that no longer
  # exists post-delete, so it silently no-ops. tool-scons is then gone for the
  # rest of the build, and the espidf hybrid envs (openevse_wifi_tft_v1*) fail at
  # the final link step with "ModuleNotFoundError: No module named
  # 'SCons.Tool.FortranCommon'" (that submodule is only imported lazily, right at
  # the end, so everything up to then builds fine). Ensure PIO Core's own
  # tool-scons is present, then sync platform.json's expected version to whatever
  # actually landed on disk so the platform's exact-string version check never
  # sees a mismatch in the first place.
  #
  # On a cold CORE3_DIR, platform.json doesn't exist until the espressif32
  # platform itself is installed -- which otherwise happens for the first time
  # inside the `pio run` below, in the very same process that then runs the
  # version check above and deletes tool-scons. Install the platform metadata
  # first (skipping its dependencies -- this is a metadata-only install) so the
  # sync below can run before that happens.
  platform_json="$CORE3_DIR/platforms/espressif32/platform.json"
  if [ ! -f "$platform_json" ] && [ -n "$core3_env" ]; then
    echo "scripts/pio: core-3 platform metadata not found, installing before tool-scons sync" >&2
    "$PIO_BIN" pkg install -e "$core3_env" --skip-dependencies >/dev/null 2>&1 \
      || echo "scripts/pio: warning: failed to pre-install core-3 platform metadata (tool-scons sync below will likely be skipped, and this run may hit the FortranCommon error described above)" >&2
  fi

  "$PIO_BIN" pkg install -g -t tool-scons >/dev/null 2>&1 \
    || echo "scripts/pio: warning: failed to install/verify PIO Core's tool-scons (this run may hit the FortranCommon error described above)" >&2
  python3 - "$CORE3_DIR" <<'PYEOF' 2>/dev/null || echo "scripts/pio: warning: tool-scons/platform.json version sync failed (this run may hit the FortranCommon error described above)" >&2
import json, os, sys

core_dir = sys.argv[1]
platform_json = os.path.join(core_dir, "platforms", "espressif32", "platform.json")
scons_json = os.path.join(core_dir, "packages", "tool-scons", "package.json")
if os.path.isfile(platform_json) and os.path.isfile(scons_json):
    with open(scons_json, encoding="utf-8") as f:
        installed_version = json.load(f)["version"]
    with open(platform_json, encoding="utf-8") as f:
        data = json.load(f)
    pkg = data.get("packages", {}).get("tool-scons")
    if pkg and pkg.get("package-version") != installed_version:
        pkg["package-version"] = installed_version
        with open(platform_json, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2)
PYEOF
else
  # core-2 / no env: leave PLATFORMIO_CORE_DIR alone (default ~/.platformio).
  echo "scripts/pio: core-2 -> PLATFORMIO_CORE_DIR=${PLATFORMIO_CORE_DIR:-$HOME/.platformio}" >&2
fi

exec "$PIO_BIN" "$@"
