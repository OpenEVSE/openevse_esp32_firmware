#!/usr/bin/env bash
#
# PlatformIO wrapper.
#
# Every firmware env now builds on the single official espressif32 platform
# (Arduino-ESP32 3.x) pinned in platformio.ini, so there is no longer a separate
# core-2 / core-3 PLATFORMIO_CORE_DIR to route between. This script is kept as a
# transparent `pio` drop-in so existing muscle memory, docs and tooling that call
# `scripts/pio` keep working.
#
# Usage: exactly like pio, e.g.
#   scripts/pio run -e openevse_wifi_v1
#   scripts/pio run -e openevse_wifi_v1_16mb -t upload
#   scripts/pio device monitor
#
# Force a specific pio binary with PLATFORMIO_BIN.
set -euo pipefail

# Resolve the real pio binary (never recurse into this wrapper).
PIO_BIN="${PLATFORMIO_BIN:-}"
if [ -z "$PIO_BIN" ]; then
  if [ -x "$HOME/.platformio/penv/bin/pio" ]; then
    PIO_BIN="$HOME/.platformio/penv/bin/pio"
  elif command -v platformio >/dev/null 2>&1; then
    PIO_BIN="$(command -v platformio)"
  else
    echo "scripts/pio: cannot find the pio/platformio executable (set PLATFORMIO_BIN)" >&2
    exit 127
  fi
fi

exec "$PIO_BIN" "$@"
