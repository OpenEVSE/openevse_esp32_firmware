#!/usr/bin/env bash
#
# PlatformIO wrapper for the two-core tree.
#
# Core 3 (espressif32 8.0.0, Arduino-ESP32 3.x) is the default platform, set in
# [env] in platformio.ini. The 4MB boards extend env:core_2 (espressif32 7.1.3,
# Arduino-ESP32 2.x) because their image has to fit dual-slot OTA.
#
# Both platforms declare ~13 package names in common (framework-arduinoespressif32,
# framework-espidf, the toolchains, several tool-*) but pin different versions, so
# building a core-2 env right after a core-3 env (or vice versa) in the SAME
# PLATFORMIO_CORE_DIR evicts and re-downloads those packages every switch.
#
# Fix: core-2 envs get their own PLATFORMIO_CORE_DIR; everything else (core 3,
# native) uses the default ~/.platformio, so bare `pio`, CI and IDE integrations
# run core 3. Switching cores then never re-downloads.
#
# Usage: exactly like pio, e.g.
#   scripts/pio run -e openevse_wifi_v1
#   scripts/pio run -e openevse_wifi_v1_16mb -t upload
#   scripts/pio device monitor
#
# Override the core-2 dir with PIO_CORE2_DIR; force a specific pio binary with
# PLATFORMIO_BIN.
set -euo pipefail

INI="$(dirname "$0")/../platformio.ini"

# Envs that extend env:core_2 (directly or through another env), derived from
# platformio.ini rather than listed here, so a new 4MB env is routed correctly
# the day it is added. Multiple parents are allowed (comma-separated or one per
# indented line).
CORE2_ENVS="$(python3 - "$INI" <<'PYEOF'
import re, sys
text = open(sys.argv[1]).read()
sections = dict(re.findall(r'^\[([^\]]+)\]\n(.*?)(?=^\[|\Z)', text, re.M | re.S))

def parents(body):
    # An option's value runs to the next non-indented line, so a multiline
    # `extends` keeps its continuation lines. Commas separate names too.
    m = re.search(r'^extends\s*=([^\n]*(?:\n[ \t]+[^\n]*)*)', body, re.M)
    if not m:
        return []
    return [p for p in re.split(r'[,\s]+', m.group(1)) if p]

def on_core2(name, seen=()):
    if name == 'env:core_2':
        return True
    if name in seen or name not in sections:
        return False
    return any(on_core2(p, seen + (name,)) for p in parents(sections[name]))

print(' '.join(s[4:] for s in sections if s.startswith('env:') and on_core2(s)))
PYEOF
)"
if [ -z "$CORE2_ENVS" ]; then
  echo "scripts/pio: could not derive the core-2 env list from platformio.ini" >&2
  exit 2
fi
CORE2_DIR="${PIO_CORE2_DIR:-$HOME/.platformio-core2}"

# Pull the -e / --environment value(s) out of the args. With none given, PlatformIO
# builds default_envs, so route by those.
envs=""
prev=""
for a in "$@"; do
  case "$prev" in
    -e|--environment) envs="$envs $a" ;;
  esac
  case "$a" in
    -e=*|--environment=*) envs="$envs ${a#*=}" ;;
  esac
  prev="$a"
done
if [ -z "$envs" ]; then
  envs="$(sed -n 's/^default_envs *= *//p' "$INI" | head -1)"
fi

want_core2=0
want_other=0
for e in $envs; do
  case " $CORE2_ENVS " in
    *" $e "*) want_core2=1 ;;
    *)        want_other=1 ;;
  esac
done

if [ "$want_core2" = 1 ] && [ "$want_other" = 1 ]; then
  echo "scripts/pio: won't build core-2 and core-3 envs in one invocation" >&2
  echo "             (they live in separate PLATFORMIO_CORE_DIRs) -- split them." >&2
  exit 2
fi

# Resolve the real pio binary (never recurse into this wrapper).
PIO_BIN="${PLATFORMIO_BIN:-}"
if [ -z "$PIO_BIN" ]; then
  if [ -x "$HOME/.platformio/penv/bin/pio" ]; then
    PIO_BIN="$HOME/.platformio/penv/bin/pio"
  elif command -v platformio >/dev/null 2>&1; then
    PIO_BIN="$(command -v platformio)"
  else
    echo "scripts/pio: cannot find the pio/platformio executable (set PLATFORMIO_BIN)" >&2
    exit 127
  fi
fi

if [ "$want_core2" = 1 ]; then
  export PLATFORMIO_CORE_DIR="$CORE2_DIR"
  echo "scripts/pio: core-2 -> PLATFORMIO_CORE_DIR=$PLATFORMIO_CORE_DIR" >&2
else
  echo "scripts/pio: core-3 -> PLATFORMIO_CORE_DIR=${PLATFORMIO_CORE_DIR:-$HOME/.platformio}" >&2
fi

exec "$PIO_BIN" "$@"
