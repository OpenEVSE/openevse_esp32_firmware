{
  "name": "openevse-e2e",
  "private": true,
  "description": "Gherkin end-to-end tests: Playwright drives the web UI of the native firmware build, paired with the OpenEVSE emulator",
  "scripts": {
    "test": "bddgen && playwright test",
    "test:smoke": "bddgen && playwright test --grep @smoke",
    "bddgen": "bddgen",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "playwright-bdd": "^9.2.1",
    "typescript": "^5.6.0"
  }
}
