###

GET {{baseUrl}}/update

###

POST {{baseUrl}}/update
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

----WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="firmware"; filename="firmware.bin"
Content-Type: application/octet-stream

< ./.pio/build/espressif_esp-wrover-kit_idf/firmware.bin
----WebKitFormBoundary7MA4YWxkTrZu0gW
###

curl -F firmware=@.pio/build/openevse_wifi_v1/firmware.bin {{baseUrl}}/update

###

GET {{baseUrl}}/debug HTTP/1.1

###

GET {{baseUrl}}/evse HTTP/1.1

###

# Get the current
GET {{baseUrl}}/override HTTP/1.1

###

# force enable the charger
POST {{baseUrl}}/override HTTP/1.1
Content-Type: application/json

{"state":"active"}

###

# force disable the charger
POST {{baseUrl}}/override HTTP/1.1
Content-Type: application/json

{"state":"disabled"}

###

# Toggle the state of the override
PATCH {{baseUrl}}/override HTTP/1.1
Content-Type: application/json

###

# Clear the manual override
DELETE {{baseUrl}}/override HTTP/1.1

### Crash reporting: reporter identity and broker URL (nulls until set)
GET {{baseUrl}}/debug/crash/identity HTTP/1.1

### Crash reporting: set the identity (the GUI generates it with crypto.getRandomValues)
POST {{baseUrl}}/debug/crash/identity HTTP/1.1
X-Requested-With: OpenEVSE
Content-Type: application/json

{"reporter_id": "0123456789abcdef0123456789abcdef", "delete_key": "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff"}

### Crash reporting: the report as the browser sends it (404 no dump, 409 no identity)
GET {{baseUrl}}/debug/crash/report HTTP/1.1

### Crash reporting: forget the identity, after the reports are erased
DELETE {{baseUrl}}/debug/crash/identity HTTP/1.1
X-Requested-With: OpenEVSE
